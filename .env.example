# /home/deploy/Bots_web_dashboard/shared/.env on the server (mode 600).

# 48+ random characters. Every hub key is derived from it (TOTP secret
# encryption, signed actions). Changing it makes the stored TOTP secret
# unreadable: run `python -m hub reset-totp` afterwards.
HUB_SECRET_KEY=

# Exactly the address the browser uses.
HUB_PUBLIC_ORIGIN=https://dashboard-x.l00t.link

# One per bot, the same value as HUB_API_TOKEN in that bot's own .env.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_BOT_TOKEN_DEALOPS=

# Optional: the bot whose API relays "failed logins" alerts to the owner.
HUB_ALERT_BOT=dealops

# Optional.
HUB_TIMEZONE=Asia/Kolkata

# Only for local development over plain http: HUB_COOKIE_SECURE=0
